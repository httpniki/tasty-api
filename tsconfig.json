{
	"compilerOptions": {
      "target": "es2022",
      "module": "commonjs",
		"rootDir": ".",
		"outDir": "./dist",
		"esModuleInterop": true,
		"allowJs": true,
		"noImplicitAny": false,
      "skipLibCheck": true,
		"moduleResolution": "node",
		"checkJs": false,
		"strict": false,
      "resolveJsonModule": true,
      "noEmitOnError": false,
      "baseUrl": ".",
      "paths": {
         "@/*": ["src/*"],
         "@user/*": ["src/user/*"], 
         "@post/*": ["src/post/*"],
         "@chat/*": ["src/chat/*"],
         "@shared/*": ["src/shared/*"],
         "@auth/*": ["src/auth/*"]
      }
	},
	"include": [ "index.ts", "src/**/*"],
	"exclude": ["node_modules", "dist"]
}
